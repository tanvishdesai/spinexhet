\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces CUB-200 consensus ablation across all six architectures. Faithfulness-weighted (FW) consensus is consistently above uniform averaging, and oracle top-$3$ consensus is higher still. Because top-$3$ uses sample-level insertion AUC for selection, it should be read as an upper-bound estimate for method curation rather than as a deployable inference protocol. Error bars indicate fold-level standard deviation.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:consensus}{{4}{9}{CUB-200 consensus ablation across all six architectures. Faithfulness-weighted (FW) consensus is consistently above uniform averaging, and oracle top-$3$ consensus is higher still. Because top-$3$ uses sample-level insertion AUC for selection, it should be read as an upper-bound estimate for method curation rather than as a deployable inference protocol. Error bars indicate fold-level standard deviation}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces RSNA concept-intervention summary. The non-leaky CBM is the primary controlled ante-hoc baseline; the leaky CBM is reported only as an ablation because its strongest concept encodes pathology presence.}}{9}{table.4}\protected@file@percent }
\newlabel{tab:cbm}{{4}{9}{RSNA concept-intervention summary. The non-leaky CBM is the primary controlled ante-hoc baseline; the leaky CBM is reported only as an ablation because its strongest concept encodes pathology presence}{table.4}{}}
